[Unit]
Description=KAM webtrade
After=network.target
# Independent from Hermes gateway and GoldenFibo :8000

[Service]
Type=simple
WorkingDirectory=__HERMES_ROOT__
Environment=PYTHONPATH=__HERMES_ROOT__
Environment=HERMES_HOME=__HERMES_HOME__
ExecStart=__HERMES_ROOT__/venv/bin/python -m plugins.trade.webtrade
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
