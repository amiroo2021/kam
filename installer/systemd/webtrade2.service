[Unit]
Description=KAM WebTrade2 trading terminal (Phase 2 — dry-run)
After=network.target
# Independent from webtrade.service (:9001) and GoldenFibo

[Service]
Type=simple
WorkingDirectory=__HERMES_ROOT__
Environment=PYTHONPATH=__HERMES_ROOT__
Environment=HERMES_HOME=__HERMES_HOME__
# Phase 2 first deployment = dry-run. WRITE_ENABLED=1 enables the
# write endpoints; DRY_RUN=1 ensures no live exchange write is ever
# performed. Switch DRY_RUN to 0 only after explicit operator approval.
Environment=WEBTRADE2_WRITE_ENABLED=1
Environment=WEBTRADE2_DRY_RUN=1
Environment=WEBTRADE2_PREVIEW_TTL_SECONDS=300
ExecStart=__HERMES_ROOT__/venv/bin/python -m plugins.trade.webtrade2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
