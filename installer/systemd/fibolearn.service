[Unit]
Description=FiboLearn read-only observation collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kam
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/kam/GoldenFibo/.venv/bin/python -m fibolearn.runner
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
