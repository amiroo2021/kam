[Unit]
Description=KAM persistent Fibo service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{HERMES_ROOT}}
Environment=PYTHONPATH={{HERMES_ROOT}}
Environment=HERMES_HOME={{HERMES_HOME}}
ExecStart={{PYTHON_EXE}} -m plugins.trade.fibo_daemon --socket-path {{SOCKET_PATH}} --state-path {{STATE_PATH}} --ledger-path {{LEDGER_PATH}} --event-log-path {{EVENT_LOG_PATH}}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
