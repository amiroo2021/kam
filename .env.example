# KAM /trade — environment reference (DOCUMENTATION ONLY)
#
# ============================================================================
# This file is a reference. It is never read, copied, or installed.
# The installer does NOT create or modify your Hermes .env.
# ============================================================================
#
# There is no enable flag. Installing the add-on enables /trade; removing it
# disables /trade. Nothing else gates the feature.
#
# Add the variables you need to your EXISTING Hermes environment file, which
# normally lives at:
#
#     $HERMES_HOME/.env          (default: ~/.hermes/.env)
#
# Exchange accounts appear in /trade only when their required variables are
# present. An incomplete block is ignored — the account simply does not show
# up. Missing credentials never crash the gateway.
#
# <ACCOUNT> is an alias you choose (e.g. MAIN, ALT, DESK1). It becomes the
# account name shown in the wizard. Account discovery is case-insensitive.
#
# Adding a new exchange requires no installer change: drop an
# x_<exchange>_agent.py file into plugins/trade/agents/ and it is discovered
# automatically.
# ----------------------------------------------------------------------------


# --- Hyperliquid ------------------------------------------------------------
# HYPERLIQUID_<ACCOUNT>_WALLET=0xYourWalletAddress
# HYPERLIQUID_<ACCOUNT>_SECRET=your_api_secret


# --- Rise -------------------------------------------------------------------
# RISE_<ACCOUNT>_WALLET=0xYourWalletAddress
# RISE_<ACCOUNT>_APISIGNERPRIVATE=your_eip712_api_signer_private_key


# --- Pacifica ---------------------------------------------------------------
# Pacifica is a Solana-based perpetual DEX. All three variables are
# required for the account to be recognised.
#
# ADDRESS          : your main Solana wallet (the one whose balance is
#                    reported). Sent as the `account` query parameter.
# AGENT_WALLET     : a SEPARATE Solana public key whose private key will
#                    sign API requests on your behalf. Bound to ADDRESS
#                    via Pacifica's `bind_agent_wallet` operation — keep
#                    it independent of your main wallet so the main key
#                    never has to leave cold storage.
# AGENT_PRIVATE_KEY: base58-encoded Ed25519 secret key (the full 64-byte
#                    Solana keypair export — 88 base58 chars).
#
# PACIFICA_<ACCOUNT>_ADDRESS=YourMainSolanaWalletPublicKey
# PACIFICA_<ACCOUNT>_AGENT_WALLET=YourAgentWalletPublicKey
# PACIFICA_<ACCOUNT>_AGENT_PRIVATE_KEY=base58_encoded_64_byte_keypair
#
# Optional — point at the testnet (defaults to mainnet):
# PACIFICA_API_BASE=https://test-api.pacifica.fi/api/v1


# --- Lighter ----------------------------------------------------------------
# All five variables are required for the account to be recognised.
# LIGHTER_<ACCOUNT>_CHAIN is the sole routing source of truth.
# Canonical uppercase values: ARBITRUM, ROBINHOOD
#
# LIGHTER_<ACCOUNT>_CHAIN=ARBITRUM
# LIGHTER_<ACCOUNT>_ACCOUNT_INDEX=0
# LIGHTER_<ACCOUNT>_APIKEY_INDEX=0
# LIGHTER_<ACCOUNT>_PUBLIC_KEY=your_public_key
# LIGHTER_<ACCOUNT>_PRIVATE_KEY=your_private_key


# --- Raydium ----------------------------------------------------------------
# RAYDIUM_<ACCOUNT>_ACCOUNT_ID=your_account_id
# RAYDIUM_<ACCOUNT>_API_KEY=your_api_key
# RAYDIUM_<ACCOUNT>_SECRET_KEY=ed25519:your_secret_key


# --- Arcus ------------------------------------------------------------------
# ARCUS_<ACCOUNT>_APISIGNINGKEY is the PUBLIC key (64 hex chars) used as the
# X-API-Key header. Signed writes additionally require the separate private
# key below; without it write operations return ARCUS_KEY_MISSING and read
# operations continue to work.
#
# ARCUS_<ACCOUNT>_WALLET=0xYourWalletAddress
# ARCUS_<ACCOUNT>_APISIGNINGKEY=your_ed25519_public_key_hex
# ARCUS_<ACCOUNT>_PRIVATE_KEY=your_ed25519_private_key_hex
#
# Optional:
# ARCUS_<ACCOUNT>_ACCOUNT_INDEX=0
# ARCUS_<ACCOUNT>_BASE_URL=https://api.arcus.xyz


# --- EdgeX (shared Hermes venv, EIP-712) ------------------------------------
# EdgeX trading runs in-process inside the shared Hermes venv. The installer
# adds edgex-python-sdk==2.0.0 with --no-deps so existing Hermes-managed
# package versions are preserved and never downgraded. Read-only menus
# (balance, positions, open orders) work without SIGNERKEY. Writes
# (new order, ladder, cancel, set_tp, set_sl, close_position) require it.
#
# EDGEX_<ACCOUNT>_ACCOUNTID=your_numeric_account_id
# EDGEX_<ACCOUNT>_APIKEY=your_api_key
# EDGEX_<ACCOUNT>_APISECRET=your_api_secret
# EDGEX_<ACCOUNT>_APIPASSPHRASE=your_api_passphrase
# EDGEX_<ACCOUNT>_SIGNERKEY=your_l2_signing_private_key
